{
  "private": true,
  "scripts": {
    "clean": "rimraf output && rimraf .spago",
    "postinstall": "spago fetch",
    "build": "spago build -p halogen --strict",
    "test": "spago test -p halogen --strict",
    "format": "purs-tidy format-in-place src test examples",
    "check-formatting": "purs-tidy check src test examples",
    "example-all": "./build-examples.sh",
    "example-ace": "spago bundle -p example-ace --module Example.Ace.Main --outfile dist/example.js",
    "example-basic": "spago bundle -p example-basic --module Example.Basic.Main --outfile dist/example.js",
    "example-components": "spago bundle -p example-components --module Example.Components.Main --outfile dist/example.js",
    "example-components-inputs": "spago bundle -p example-components-inputs --module Example.Components.Inputs.Main --outfile dist/example.js",
    "example-components-multitype": "spago bundle -p example-components-multitype --module Example.Components.Multitype.Main --outfile dist/example.js",
    "example-driver-io": "spago bundle -p example-driver-io --module Example.Driver.IO.Main --outfile dist/example.js",
    "example-driver-routing": "spago bundle -p example-driver-routing --module Example.Driver.Routing.Main --outfile dist/example.js",
    "example-driver-websockets": "spago bundle -p example-driver-websockets --module Example.Driver.Websockets.Main --outfile dist/example.js",
    "example-effects-aff-ajax": "spago bundle -p example-effects-aff-ajax --module Example.Effects.Aff.Ajax.Main --outfile dist/example.js",
    "example-effects-effect-random": "spago bundle -p example-effects-effect-random --module Example.Effects.Effect.Random.Main --outfile dist/example.js",
    "example-higher-order-components": "spago bundle -p example-higher-order-components --module Example.HOC.Main --outfile dist/example.js",
    "example-interpret": "spago bundle -p example-interpret --module Example.Interpret.Main --outfile dist/example.js",
    "example-keyboard-input": "spago bundle -p example-keyboard-input --module Example.KeyboardInput.Main --outfile dist/example.js",
    "example-lifecycle": "spago bundle -p example-lifecycle --module Example.Lifecycle.Main --outfile dist/example.js",
    "example-memoized-lazy": "spago bundle -p example-memoized-lazy --module Example.MemoizedLazy.Main --outfile dist/example.js"
  },
  "devDependencies": {
    "ace-builds": "^1.44.0",
    "esbuild": "^0.28.2",
    "purs-tidy": "^0.11.1",
    "rimraf": "^6.1.3"
  }
}
